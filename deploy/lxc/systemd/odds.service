[Unit]
Description=Poker Odds Lab backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odds
Group=odds
WorkingDirectory=/opt/odds
Environment=PORT=8789
Environment=HOST=127.0.0.1
Environment=APP_STATIC_ROOT=/opt/odds
EnvironmentFile=-/etc/odds/odds.env
ExecStart=/opt/odds/odds
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TasksMax=512
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
